# =============================================================================
# Variables de entorno - DeepFlow IoT Dashboard
# Copiar este archivo como .env.local y completar con los valores reales.
# NUNCA commitear .env.local ni .env con credenciales reales.
# =============================================================================

# Base de datos MySQL
# Formato: mysql://usuario:password@host:puerto/nombre_base_de_datos
MYSQL_URL=mysql://usuario:password@host:3306/poc_dataflow

# AWS IoT Core — Collector MQTT
# Endpoint disponible en: AWS IoT Core → Configuración → Punto de enlace de datos del dispositivo
AWS_IOT_ENDPOINT=XXXXXXXXXX-ats.iot.us-east-2.amazonaws.com

# Topic MQTT a escuchar (por defecto: dispositivos/ur41/telemetria)
MQTT_TOPIC=dispositivos/ur41/telemetria

# Ngrok — solo necesario al usar ngrok para demos (actualizar cada sesión)
# Solo el dominio, sin https://
# Ejemplo: nonparty-dorinda-hyperphysically.ngrok-free.dev
NGROK_URL=
